
if [ $# -ne 3 ] ; then
	echo 'Usage: gribinterp input_grib output_grib yyyymmddhh'
	echo "`date` $0: Wrong usage." >>ERROR.out
	exit 8
fi
set -x
#
# gribinterp :
#
inputfile="$1"
outputfile="$2"
date="$3"

IGRDIN=640
JGRDIN=320
IGRDOUT=640
JGRDOUT=320

     yy1=`echo $date | cut -c1-4`
     mm1=`echo $date | cut -c5-6`
     dd1=`echo $date | cut -c7-8`
     hh1=`echo $date | cut -c9-10`

cat > interparm <<EOF
 &NAMGRBIN IDIM=$IGRDIN,JDIM=$JGRDIN,
  IOUT=$IGRDOUT,JOUT=$JGRDOUT,
 &END
 &NAMGRBOUT I2O=0,
   fngrib='$inputfile',
   IGRIDO=255, PROJO=1.0, ORIENTO=127.5,
   DELXO=60000.0, DELYO=60000.0,
   TRUTHO=60.0, COTRUO=60.0,
   RLAT1O=24.741, RLON1O=110.78,
   RLAT2O=47.491, RLON2O=148.404,
   ICHGPD=1,
   KPDS8=$yy1,KPDS9=$mm1,KPDS10=$dd1,KPDS11=$hh1,
   KPDS14=0,KPDS15=0,
 &END
EOF

#
# Directories
#
dir=`echo $0 | sed 's?/[^/]*$??g'`
currdir=`pwd`
cd $dir
ETC_DIR=`pwd`
cd $currdir
currdir=`pwd`
#
FTNID=fort.
#
if [ origin = cray -o origin = t90 -o origin = t3e ] ; then
  assign -R
fi
#ln -fs $inputfile ${FTNID}11
ln -fs $outputfile ${FTNID}51
#
$ETC_DIR/gribinterp.x >gribinterp.out < interparm
if [ $? -ne 0 ] ; then
	echo ' Execution failed'
	echo "`date` $0: Execution failed." >>ERROR.out
	exit 8
fi
