#!/bin/sh
set -x
#
# $1 : input_grib file
# $2 : output_grib file
#
if [ $# -ne 2 ] ; then
	echo 'Usage: gribinterp input_grib output_grib'
	echo "`date` $0: Wrong usage." >>ERROR.out
	exit 8
fi
#
# gribinterp :
#
#
initime=${initime:=1990030900}
endhour=${endhour:=1990030900}
ihour=${ihour:=6}
fhour=${fhour:=0}
if [ $fhour -ne 0 ]; then
sfhour=`expr $fhour - $ihour`
else
sfhour=$fhour
fi
efhour=$fhour
#
inputfile="$1"
outfile="$2"

IGRDIN=${IGRDIN:=200}
JGRDIN=${JGRDIN:=100}

IGRDOUT=${IGRDOUT:=129}
JGRDOUT=${JGRDOUT:=100}

slon=0.
elon=359.0
slat=-90.0
elat=90.0
dlon=${dlon:=0.5}
dlat=${dlat:=0.5}

casein=rpgb
caseout=rpgb

date=$initime
hx=0
#
yy1=`echo $date | cut -c1-4`
mm1=`echo $date | cut -c5-6`
dd1=`echo $date | cut -c7-8`
hh1=`echo $date | cut -c9-10`
#
dlon=`echo "(${dlon}*1000)"| bc`
dlat=`echo "(${dlat}*1000)"| bc`
#
# selection of projection
#
# PROJO=0  : mercater
# PROJO=1  : north polar projection
# PROJO=-1 : south polar projection
# PROJO=2  : north lambert projection
# PROJO=-2 : south lambert projection
# PROJO=3  : equal lat lon projection
# PROJO=-3 : equal lat lon projection
# PROJO=4  : gaussian projection
# PROJO=-4 : gaussian projection
#

#cat > interparm <<EOF
# &NAMGRBIN IDIM=$IGRDIN,JDIM=$JGRDIN,
#  IOUT=$IGRDOUT,JOUT=$JGRDOUT,
# &END
# &NAMGRBOUT I2O=1,
#   fngrib='$inputfile',
#   IGRIDO=255, PROJO=1.0, ORIENTO=127.5,
#   DELXO=60000.0, DELYO=60000.0,
#   TRUTHO=60.0, COTRUO=60.0,
#   RLAT1O=24.741, RLON1O=110.78,
#   RLAT2O=47.491, RLON2O=148.404,
#   ICHGPD=1,
#   KPDS8=$yy1,KPDS9=$mm1,KPDS10=$dd1,KPDS11=$hh1,
#   KPDS14=0,KPDS15=0,
# &END
#EOF
cat > interparm <<EOF
 &NAMGRBIN IDIM=$IGRDIN,JDIM=$JGRDIN,
  IOUT=$IGRDOUT,JOUT=$JGRDOUT,
 &END
 &NAMGRBOUT I2O=1,
   fngrib='$inputfile',
   IGRIDO=255, PROJO=-3.0, ORIENTO=127.5,
   DELXO=${dlon}, DELYO=${dlat},
   TRUTHO=60.0, COTRUO=60.0,
   RLAT1O=${elat}, RLON1O=${slon},
   RLAT2O=${slat}, RLON2O=${elon},
   ICHGPD=0,
   KPDS8=$yy1,KPDS9=$mm1,KPDS10=$dd1,KPDS11=$hh1,
   KPDS14=${sfhour},KPDS15=${efhour},
 &END
EOF

#
#
# Directories
#
currdir=`pwd`
cd $dir
ETC_DIR=@ETC_DIR@
cd $currdir
#
FTNID=fort.
#
if [ origin = cray -o origin = t90 -o origin = t3e ] ; then
  assign -R
fi
ln -fs ${outfile} ${FTNID}51
#
$ETC_DIR/gribinterp.x >gribinterp.out < interparm
if [ $? -ne 0 ] ; then
	echo ' Execution failed'
	echo "`date` $0: Execution failed." >>ERROR.out
	exit 8
fi
