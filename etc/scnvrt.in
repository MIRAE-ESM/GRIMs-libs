#!/bin/sh
if [ $# -ne 7 ] ; then
	echo 'Usage: scnvrt gsm0rsm sfcftyp jcap:idim:jdim:kdim newyr:newmo:newdy:newhr:fhnew infmt:ofmt isig:isfc osig:osfc' 
	echo "`date` $0: Wrong usage" >>ERROR.out
	exit 8 
fi
#
# rsm0gsm [gsm,rsm]
# sfcftyp [osu1,osu2,noa1]
# newyr,newmo,newdy,newhr,fhnew  -1 for keeping original date record
#
dir=`echo $0 | sed 's?/[^/]*$??g'`
currdir=`pwd`
cd $dir
ETC_DIR=`pwd`
cd $currdir
#
gsm0rsm=$1
sfcftyp=$2
#
jcap=`echo $3 | cut -d':' -f1`
idim=`echo $3 | cut -d':' -f2`
jdim=`echo $3 | cut -d':' -f3`
kdim=`echo $3 | cut -d':' -f4`
#echo "jcap=$jcap idim=$idim jdim=$jdim kdim=$kdim"
#
newyr=`echo $4 | cut -d':' -f1`
newmo=`echo $4 | cut -d':' -f2`
newdy=`echo $4 | cut -d':' -f3`
newhr=`echo $4 | cut -d':' -f4`
fhnew=`echo $4 | cut -d':' -f5`
#echo "newyr=$newyr newmo=$newmo newdy=$newdy newhr=$newhr fhnew=$fhnew"
#
infmt=`echo $5 | cut -d':' -f1`
ofmt=`echo $5 | cut -d':' -f2`
#
isig=`echo $6 | cut -d':' -f1`
isfc=`echo $6 | cut -d':' -f2`
#echo isig=$isig
#echo isfc=$isfc
#
osig=`echo $7 | cut -d':' -f1`
osfc=`echo $7 | cut -d':' -f2`
#echo osig=$osig
#echo osfc=$osfc
#
if [ ! -s $isig ] ; then
	echo "<Warning> $isig:  No such file"
	echo "<Warning> `date` $0: $isig. No such file." >>ERROR.out
fi
if [ ! -s $isfc ] ; then
	echo "<Warning> $isfc:  No such file"
	echo "<Warning> `date` $0: $isfc. No such file." >>ERROR.out
fi
#
if [ @MACHINE@ = x1e ] ; then
        . /opt/modules/modules/init/sh
        module load open pbs PrgEnv
        FILENV=filenv.$$
        export FILENV
        assign -R
else
        rm -f @FTNID@[0-9]* 2>/dev/null
fi
#
issfc=1
issig=1

if [  @MACHINE@ = x1e ] ; then
   if [ $isig != "dummy" ]; then
	   @FTASS@ $isig -Nieee_32 -Ff77 -Cascii @FTNID@11
   else
      issig=0
   fi
   if [ $isfc != "dummy" ]; then
      @FTASS@ $isfc -Nieee_32 -Ff77 -Cascii @FTNID@12
   else
      issfc=0
   fi
else
   if [ $isig != "dummy" ]; then
	   @FTASS@ $isig @FTNID@11
   else
      issig=0
   fi
   if [ $isfc != "dummy" ]; then
      @FTASS@ $isfc @FTNID@12
   else
      issfc=0
   fi
fi
if [ $issig -eq 1 ]; then
   @FTASS@ $osig @FTNID@51
fi
if [ $issfc -eq 1 ]; then
   @FTASS@ $osfc @FTNID@52
fi
if [ @MACHINE@ = linux_intel ]; then
    if [ $infmt = ieee ]; then
        FORT_CONVERT11=BIG_ENDIAN; export FORT_CONVERT11
        FORT_CONVERT12=BIG_ENDIAN; export FORT_CONVERT12
    fi
    if [ $ofmt = ieee ]; then
        FORT_CONVERT51=BIG_ENDIAN; export FORT_CONVERT51
        FORT_CONVERT52=BIG_ENDIAN; export FORT_CONVERT52
    fi
fi
#
cat > scnvrt.data << EOF
   &NAMCNV
   GSM0RSM='$gsm0rsm',
   SFCFTYP='$sfcftyp',
   INFMT='$infmt',OFMT='$ofmt',
   JCAP=$jcap,IDIM=$idim,JDIM=$jdim,KDIM=$kdim,
   NEWYR=$newyr,NEWMO=$newmo,NEWDY=$newdy,NEWHR=$newhr,
   FHNEW=$fhnew.,
   ISSIG=$issig, ISSFC=$issfc,
   &END
EOF
#
@RUNENV@ $ETC_DIR/scnvrt.x <scnvrt.data 1>scnvrt.out 2>&1
if [ $? -ne 0 ] ; then
	echo " $0: Execution failed"
	echo "`date` $0: Execution failed " >>ERROR.out
   exit 8
fi
rm -f $FILENV @FTNID@* scnvrt.data >/dev/null
exit 0
