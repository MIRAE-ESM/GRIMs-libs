clean :
	- rm -rf rii_files
clean_all :
	- rm -f @CON_DIR@/*.grib  @CON_DIR@/*.asc ${CON_DIR}/*.bufr
	- rm -f @CON_DIR@/*.ieee @CON_DIR@/*.bin @CON_DIR@/*.daily
	- rm -f @CON_DIR@/flwdirGSWP2.hlf.asc
	- rm -rf rii_files


.SUFFIXES : .Z

.Z:
	gunzip -c $< >$*  || exit 8 ; \
