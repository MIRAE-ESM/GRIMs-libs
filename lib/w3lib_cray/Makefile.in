LIB = w3lib.a
OBJS = aea.o baread.o datimx.o getgbss.o getgir.o iw3jdn.o iw3pds.o \
ixgb.o pdsens.o pdseup.o rdgb.o skgb.o unpindx.o w3fi01.o w3fi04.o \
w3fi58.o w3fi59.o w3fi63.o w3fi68.o w3fi71.o w3fi72.o w3fi73.o \
w3fi74.o w3fi75.o w3fi76.o w3fi82.o w3fi83.o w3fp11.o w3fs26.o \
w3tagb.o xmovex.o xstore.o gbytes.o sbyte.o sbytes.o baopen.o

SHELL = @SHELL@
AR = @AR@
AS = @AS@
CP = @CP@
RM = @RM@
CD = @CD@
CHMOD = @CHMOD@

LIB_DIR = @LIB_DIR@
F77 = @W3LIB_F77@
FORT_FLAGS = @W3LIB_FORT_FLAGS@
LOAD_FLAGS = @W3LIB_LOAD_FLAGS@
INCLUDE_DIR = @W3LIB_INCLUDE_DIR@

${LIB} : ${OBJS}
	${AR} -r $@ $?
	${CP} -f ${LIB} ${LIB_DIR}; \
	${CD} ${LIB_DIR}; \
	${CHMOD} 755 ${LIB}

.SUFFIXES :

.SUFFIXES : .o .f .s

.f.o :
	${F77} ${FORT_FLAGS} -c $<

.s.o :
	${AS} -l $*.l -L msg$*.l  $<

clean : 
	- ${RM} -rf *.o *.a core rii_files
	- ${RM} -rf rii_files

# DO NOT DELETE
