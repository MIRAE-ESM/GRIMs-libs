LIB = w3lib.a
OBJS = pdseup.o w3fi63.o datimx.o w3fi83.o gbyte.o sbyte.o w3fp11.o \
gbytes.o sbytes.o w3fs26.o getgbss.o w3pack.o aea.o \
iw3jdn.o w3tagb.o assign.o iw3pds.o unpindx.o xmovex.o \
pdsens.o w3fi04.o w3fi01.o \
baopen.o baread.o getgir.o ixgb.o rdgb.o skgb.o \
nainit.o naopen.o nbaread.o ngetgir.o nixgb.o nrdgb.o nskgb.o


SHELL = @SHELL@
AR = @AR@
CP = @CP@
RM = @RM@
CD = @CD@
CHMOD = @CHMOD@

NETCDF_DIR = @NETCDF_DIR@
LAPACK_DIR = @LAPACK_DIR@
LIB_DIR = @LIB_DIR@
F77 = @W3LIB_F77@
FORT_FLAGS = @W3LIB_FORT_FLAGS@
LOAD_FLAGS = @W3LIB_LOAD_FLAGS@
INCLUDE_DIR = @W3LIB_INCLUDE_DIR@

${LIB} : ${OBJS}
	${AR} -r $@ $?
	${CP} -f ${LIB} ${LIB_DIR}; \
	${CD} ${LIB_DIR}; \
	${CHMOD} 755 ${LIB}

.SUFFIXES :

.SUFFIXES : .o .f90

.F90.o :
	${F77} ${FORT_FLAGS} -c $<

clean :
	- ${RM} -f *.o *.a core 
	- ${RM} -rf rii_files

# DO NOT DELETE
