
LIB = w3lib.a
OBJS = gbyte.o gbytes.o sbyte.o sbytes.o aea.o assign.o baread.o datimx.o \
getgbss.o getgir.o iw3jdn.o iw3pds.o ixgb.o pdsens.o pdseup.o rdgb.o \
skgb.o unpindx.o w3fi01.o w3fi04.o w3fi63.o w3fi83.o w3fp11.o w3fs26.o \
w3pack.o w3tagb.o xmovex.o
SOURCES = ${OBJS:.o=.f}
SHELL = /bin/sh
#
# sb=0,1,2  0..NCAR, 1..Henry, 2..NCAR-SUNSPARC+1  SBYTE/SBYTES
# gb=0,1,2  0..NCAR, 1..Henry, 2..NCAR-SUNSPARC+1  GBYTE/GBYTES
#
SHELL = @SHELL@
AR = @AR@
CP = @CP@
RM = @RM@
CD = @CD@
CHMOD = @CHMOD@

LIB_DIR = @LIB_DIR@
F77 = @W3LIB_F77@
FORT_FLAGS = @W3LIB_FORT_FLAGS@
LOAD_FLAGS = @W3LIB_LOAD_FLAGS@
INCLUDE_DIR = @W3LIB_INCLUDE_DIR@

${LIB} : ${OBJS}
	${AR} -r $@ $?
	${CP} -f ${LIB} ${LIB_DIR}; \
	${CD} ${LIB_DIR}; \
	${CHMOD} 755 ${LIB}

.SUFFIXES :

.SUFFIXES : .o .f

.f.o :
	${F77} ${FORT_FLAGS} -c $<

clean :
	- ${RM} -f *.o *.a core 
	- ${RM} -rf rii_files

# DO NOT DELETE
