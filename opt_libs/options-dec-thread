SHELL=/bin/sh
AR=ar
AS=as
CP=cp
RM=rm
CD=cd
CC=cc
CPP='cpp -C'
MAKE=make
MKDIR=mkdir
CHMOD=chmod
ECHO=echo
FTNID=fort.
FTASS='ln -fs'
RUNENV=
#
#  Model compiler options
#
F77=f90
FORT_FLAGS="-r8 -i8 -O4 -convert big_endian -fpe1 -module ../include"
LOAD_FLAGS="-r8 -i8 -O4 -convert big_endian -fpe1"
EXTRA_LIBS=
#
#  UTILS is normally same as the model options
#
UTIL_F77=f90
UTIL_FORT_FLAGS="-r8 -O4 -convert big_endian -fpe1"
UTIL_LOAD_FLAGS="-r8 -O4 -convert big_endian -fpe1"
#
W3LIB_F77=f90
W3LIB_FORT_FLAGS="-fpe1 -convert big_endian"
W3LIB_LOAD_FLAGS="-fpe1 -convert big_endian"
#
FFT99M=fft99m.o
#
BFLIB_F77=f90
BFLIB_FORT_FLAGS="-r8 -i8 -fpe1 -convert big_endian"
BFLIB_LOAD_FLAGS="-r8 -i8 -fpe1 -convert big_endian"
#
MTNSUBMIT=
