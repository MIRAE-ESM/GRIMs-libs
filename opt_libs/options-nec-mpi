#  UTIL
#
UTIL_F77=f90
UTIL_FORT_FLAGS='-Cvopt -R2 -Wf"-L source -pvctl fullmsg vwork=stack noassume" -ftrace -f3 -ew -I./MODS -llapack_64 -lblas_64 -lfft_64'
UTIL_LOAD_FLAGS='-Cvopt -R2 -Wf"-L source -pvctl fullmsg vwork=stack noassume" -ftrace -f3 -ew -I./MODS -llapack_64 -lblas_64 -lfft_64'
#
W3LIB_F77=f90
W3LIB_FORT_FLAGS='-Cvopt -R2 -Wf"-L source -pvctl fullmsg vwork=stack noassume" -ftrace -f3 -ew'
W3LIB_LOAD_FLAGS='-Cvopt -R2 -Wf"-L source -pvctl fullmsg vwork=stack noassume" -ftrace -f3 -ew'
