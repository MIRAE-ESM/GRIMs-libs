SHELL=/bin/sh
AR=ar
AS=as
CP=cp
RM=rm
CD=cd
CC=c++
CPP=/usr/lib/cpp
MAKE=make
MKDIR=mkdir
CHMOD=chmod
ECHO=echo
FTNID=fort.
FTASS='ln -fs'
RUNENV=
#
#  Model compiler options
#
F77=f90
FORT_FLAGS='-Cvopt -R2 -Wf"-L source -pvctl fullmsg vwork=stack noassume" -ftrace -f3 -ew -I./MODS -llapack_64 -lblas_64 -lfft_64'
LOAD_FLAGS='-Cvopt -R2 -Wf"-L source -pvctl fullmsg vwork=stack noassume" -ftrace -f3 -ew -I./MODS -llapack_64 -lblas_64 -lfft_64'
EXTRA_LIBS="-lfft_64 -lblas_64"
