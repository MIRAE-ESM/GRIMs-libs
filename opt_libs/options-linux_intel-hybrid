SHELL=/bin/sh
AR=ar
AS=as
CP=cp
RM=rm
CD=cd
CC=icc
CPP='cpp -traditional-cpp'
MAKE=make
MKDIR=mkdir
CHMOD=chmod
ECHO=echo
FTNID=fort.
FTASS='ln -fs'
#
#  Model compiler options (except fcst related)
#
F77=ifort
F77_FCST=mpif90
FORT_FLAGS="-r8 -O2 -openmp -DLINUX -convert big_endian -module ../include -fp-model source"
LOAD_FLAGS="${FORT_FLAGS}"
EXTRA_LIBS=
#
#  UTILS is normally same as the model options
#
UTIL_F77=ifort
UTIL_FORT_FLAGS="-r8 -O2 -DLINUX -convert big_endian -fp-model source"
UTIL_LOAD_FLAGS="-r8 -O2 -DLINUX -convert big_endian -fp-model source"
#
W3LIB_F77=ifort
W3LIB_FORT_FLAGS="-convert big_endian -assume byterecl -fp-model source"
W3LIB_LOAD_FLAGS="-convert big_endian -assume byterecl -fp-model source"
#
FFT99M=fft99m.o
#
BFLIB_F77=ifort
BFLIB_FORT_FLAGS="-r8 -O2 -DLINUX -convert big_endian -fp-model source"
BFLIB_LOAD_FLAGS="-r8 -O2 -DLINUX -convert big_endian -fp-model source"
#
